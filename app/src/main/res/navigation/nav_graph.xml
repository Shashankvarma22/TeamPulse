<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/auth_graph">

    <!-- Authentication Flow -->
    <navigation
        android:id="@+id/auth_graph"
        app:startDestination="@id/signInFragment">

        <fragment
            android:id="@+id/signInFragment"
            android:name="com.cutm.TeamPulse.ui.auth.SignInFragment"
            android:label="@string/sign_in_title"
            tools:layout="@layout/fragment_sign_in">

            <!-- Navigate to teacher graph after successful teacher sign-in -->
            <action
                android:id="@+id/action_signIn_to_teacher_graph"
                app:destination="@id/teacher_graph"
                app:popUpTo="@id/auth_graph"
                app:popUpToInclusive="true" />

            <!-- Navigate to student graph after successful student sign-in -->
            <action
                android:id="@+id/action_signIn_to_student_graph"
                app:destination="@id/student_graph"
                app:popUpTo="@id/auth_graph"
                app:popUpToInclusive="true" />

        </fragment>
    </navigation>

    <!-- Teacher Flow -->
    <navigation
        android:id="@+id/teacher_graph"
        app:startDestination="@id/teacherHomeFragment">

        <fragment
            android:id="@+id/teacherHomeFragment"
            android:name="com.cutm.TeamPulse.ui.teacher.TeacherHomeFragment"
            android:label="@string/teacher_home_title"
            tools:layout="@layout/fragment_teacher_home">

            <action
                android:id="@+id/action_teacherHome_to_teacherTaskList"
                app:destination="@id/teacherTaskListFragment" />

            <action
                android:id="@+id/action_teacherHome_to_projectDetail"
                app:destination="@id/projectDetailFragment"
                app:enterAnim="@android:anim/slide_in_left"
                app:exitAnim="@android:anim/fade_out"
                app:popEnterAnim="@android:anim/fade_in"
                app:popExitAnim="@android:anim/slide_out_right" />
        </fragment>

        <fragment
            android:id="@+id/projectDetailFragment"
            android:name="com.cutm.TeamPulse.ui.teacher.ProjectDetailFragment"
            android:label="@string/project_detail_title"
            tools:layout="@layout/fragment_project_detail">

            <argument
                android:name="projectId"
                app:argType="string" />

            <action
                android:id="@+id/action_projectDetail_to_teacherTaskList"
                app:destination="@id/teacherTaskListFragment"
                app:enterAnim="@android:anim/slide_in_left"
                app:exitAnim="@android:anim/fade_out"
                app:popEnterAnim="@android:anim/fade_in"
                app:popExitAnim="@android:anim/slide_out_right" />
        </fragment>

        <fragment
            android:id="@+id/teacherTaskListFragment"
            android:name="com.cutm.TeamPulse.ui.teacher.TeacherTaskListFragment"
            android:label="Tasks"
            tools:layout="@layout/fragment_teacher_task_list">

            <argument
                android:name="projectId"
                app:argType="string" />
            <argument
                android:name="projectName"
                app:argType="string" />
        </fragment>
    </navigation>

    <!-- Student Flow -->
    <navigation
        android:id="@+id/student_graph"
        app:startDestination="@id/studentHomeFragment">

        <fragment
            android:id="@+id/studentHomeFragment"
            android:name="com.cutm.TeamPulse.ui.student.StudentHomeFragment"
            android:label="@string/student_home_title"
            tools:layout="@layout/fragment_student_home" />
    </navigation>

    <!-- Role Pending State (for users not yet enrolled) -->
    <fragment
        android:id="@+id/rolePendingFragment"
        android:name="com.cutm.TeamPulse.ui.rolepending.RolePendingFragment"
        android:label="@string/role_pending_title"
        tools:layout="@layout/fragment_role_pending" />

    <!-- DEBUG ONLY: Task Assignment Test Utility
         NOT WIRED INTO PRODUCTION NAVIGATION
         Access manually via fragment transaction for testing
         MUST BE REMOVED before production release -->
    <fragment
        android:id="@+id/debugSeedFragment"
        android:name="com.cutm.TeamPulse.debug.DebugSeedFragment"
        android:label="[DEBUG] Seed Utility"
        tools:layout="@layout/fragment_debug_seed" />

</navigation>
