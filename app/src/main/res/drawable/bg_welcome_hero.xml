<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base navy background -->
    <item android:drawable="@color/background" />

    <!-- Gradient overlay: indigo to navy with cyan accent -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:startColor="#1a1f3a"
                android:centerColor="#0f172a"
                android:endColor="#0d1b2a"
                android:type="linear" />
        </shape>
    </item>

    <!-- Abstract accent: semi-transparent cyan circles for modern feel -->
    <item android:top="0dp" android:right="0dp">
        <shape android:shape="oval">
            <solid android:color="#06b6d416" />
            <size android:width="200dp" android:height="200dp" />
        </shape>
    </item>

    <item android:bottom="20dp" android:left="-40dp">
        <shape android:shape="oval">
            <solid android:color="#6366f116" />
            <size android:width="150dp" android:height="150dp" />
        </shape>
    </item>
</layer-list>
