<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true"
    android:clipToPadding="false">

    <!-- Premium atmospheric background -->
    <ImageView
        android:id="@+id/backgroundAtmosphere"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_header_atmosphere"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Scrollable content container -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="28dp"
            android:paddingTop="80dp"
            android:paddingBottom="40dp">

            <!-- Pulse motif -->
            <ImageView
                android:id="@+id/pulseMotif"
                android:layout_width="70dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_pulse_motif"
                android:alpha="0.85"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- TeamPulse branding -->
            <TextView
                android:id="@+id/brandText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="TeamPulse"
                android:textColor="@color/text_primary"
                android:textSize="32sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.01"
                android:gravity="center"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/pulseMotif"
                tools:ignore="HardcodedText" />

            <!-- Tagline -->
            <TextView
                android:id="@+id/taglineText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Collaborate. Track progress.\nDeliver together."
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:fontFamily="sans-serif"
                android:letterSpacing="0.02"
                android:lineSpacingExtra="2dp"
                android:gravity="center"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/brandText"
                tools:ignore="HardcodedText" />

            <!-- Premium authentication card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/authCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                app:cardBackgroundColor="#1A1D27"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp"
                app:strokeColor="#2A3B5A"
                app:strokeWidth="1.5dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/taglineText">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="28dp">

                    <!-- Welcome heading -->
                    <TextView
                        android:id="@+id/welcomeHeading"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Welcome to\nTeamPulse"
                        android:textColor="@color/text_primary"
                        android:textSize="26sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="-0.01"
                        android:lineSpacingExtra="2dp"
                        android:gravity="center"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:ignore="HardcodedText" />

                    <!-- Supporting copy -->
                    <TextView
                        android:id="@+id/welcomeSubtext"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Track team collaboration, projects and progress in one place."
                        android:textColor="@color/text_secondary"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif"
                        android:lineSpacingExtra="3dp"
                        android:letterSpacing="0.01"
                        android:gravity="center"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/welcomeHeading"
                        tools:ignore="HardcodedText" />

                    <!-- Google Sign-In Button with premium gradient -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/googleSignInButton"
                        android:layout_width="0dp"
                        android:layout_height="58dp"
                        android:layout_marginTop="32dp"
                        android:text="Sign in with Google"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textAllCaps="false"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0"
                        app:backgroundTint="@null"
                        android:background="@drawable/btn_google_signin_gradient"
                        app:icon="@drawable/ic_google_logo"
                        app:iconGravity="textStart"
                        app:iconPadding="10dp"
                        app:iconSize="22dp"
                        app:iconTint="@null"
                        app:cornerRadius="29dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/welcomeSubtext"
                        tools:ignore="HardcodedText" />

                    <!-- Loading indicator -->
                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/signInProgress"
                        style="@style/Widget.TeamPulse.CircularProgressIndicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:contentDescription="@string/cd_loading"
                        android:indeterminate="true"
                        android:visibility="gone"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/googleSignInButton" />

                    <!-- Status message -->
                    <TextView
                        android:id="@+id/statusText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:maxLines="2"
                        android:visibility="gone"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/signInProgress"
                        tools:text="Sign-in was cancelled."
                        tools:visibility="visible" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
