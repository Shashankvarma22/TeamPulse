<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Premium Atmospheric Gradient Header -->
    <View
        android:id="@+id/headerBackground"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:background="@drawable/bg_header_atmosphere" />

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/text_primary"
            app:title="@string/project_detail_title"
            app:titleTextAppearance="@style/TextAppearance.TeamPulse.TitleLarge"
            app:titleTextColor="@color/text_primary" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding_horizontal">

            <!-- Project Info Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/projectInfoCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                app:cardBackgroundColor="@color/surface_elevated"
                app:strokeColor="@color/border_accent"
                app:strokeWidth="1dp"
                app:cardElevation="2dp"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:contentPadding="@dimen/spacing_base">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/projectNameText"
                        style="@style/TextAppearance.TeamPulse.TitleMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:letterSpacing="-0.01"
                        tools:text="Mobile App Development" />

                    <!-- Status indicator with icon -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="@dimen/spacing_sm"
                            android:tint="@color/secondary"
                            app:srcCompat="@drawable/ic_status_in_progress" />

                        <TextView
                            android:id="@+id/projectStatusText"
                            style="@style/TextAppearance.TeamPulse.BodyMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_secondary"
                            android:letterSpacing="0.02"
                            tools:text="Active" />

                    </LinearLayout>

                    <!-- Due date with icon -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="@dimen/spacing_sm"
                            android:tint="@color/tertiary"
                            app:srcCompat="@drawable/ic_calendar_today" />

                        <TextView
                            android:id="@+id/projectDueDateText"
                            style="@style/TextAppearance.TeamPulse.BodyMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_secondary"
                            android:letterSpacing="0.02"
                            tools:text="Due: Mar 15, 2027" />

                    </LinearLayout>

                    <!-- Created date with icon -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="@dimen/spacing_sm"
                            android:tint="@color/primary"
                            app:srcCompat="@drawable/ic_calendar_today" />

                        <TextView
                            android:id="@+id/projectCreatedText"
                            style="@style/TextAppearance.TeamPulse.BodyMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_secondary"
                            android:letterSpacing="0.02"
                            tools:text="Created: Jan 10, 2027" />

                    </LinearLayout>

                    <!-- GitHub with icon (show only if has value) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:gravity="center_vertical"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="@dimen/spacing_sm"
                            android:tint="@color/text_muted"
                            app:srcCompat="@drawable/ic_badge" />

                        <TextView
                            android:id="@+id/projectGithubText"
                            style="@style/TextAppearance.TeamPulse.BodyMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_secondary"
                            android:letterSpacing="0.02"
                            tools:text="github.com/team/project" />

                    </LinearLayout>

                    <!-- Manage Tasks Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/manageTasksButton"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xl"
                        android:text="@string/project_detail_manage_tasks"
                        app:icon="@drawable/ic_task"
                        app:iconTint="@color/on_secondary"
                        app:iconGravity="textStart" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Teams Section Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_spacing"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Section title with caption styling -->
                <TextView
                    android:id="@+id/teamsSectionHeader"
                    style="@style/TextAppearance.TeamPulse.LabelMedium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/project_detail_teams_header"
                    android:textColor="@color/text_muted"
                    android:letterSpacing="0.12"
                    android:textAllCaps="true"
                    tools:text="TEAMS (3)" />

                <!-- Create Team Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/createTeamButton"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/project_detail_create_team"
                    app:icon="@drawable/ic_add"
                    app:iconTint="@color/on_primary"
                    app:iconGravity="textStart" />

            </LinearLayout>

            <!-- Teams List Container -->
            <LinearLayout
                android:id="@+id/teamsListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <!-- Team cards will be added programmatically -->

            </LinearLayout>

            <!-- Empty State for Teams -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/teamsEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:visibility="gone"
                app:cardBackgroundColor="@color/surface_elevated"
                app:strokeColor="@color/border_accent"
                app:strokeWidth="1dp"
                app:cardElevation="2dp"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:contentPadding="@dimen/spacing_xl">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        style="@style/TextAppearance.TeamPulse.TitleMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/project_detail_empty_teams"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        style="@style/TextAppearance.TeamPulse.BodyMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/project_detail_empty_teams_hint"
                        android:textColor="@color/text_secondary"
                        android:gravity="center" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
