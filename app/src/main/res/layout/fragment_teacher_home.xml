<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/screen_padding_horizontal"
        android:paddingEnd="@dimen/screen_padding_horizontal"
        android:paddingTop="@dimen/spacing_xl"
        android:paddingBottom="@dimen/spacing_xl"
        tools:context=".ui.teacher.TeacherHomeFragment">

        <!-- Header -->
        <TextView
            android:id="@+id/greetingText"
            style="@style/TextAppearance.TeamPulse.HeadlineMedium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/teacher_home_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Welcome, Prof. Smith" />

        <!-- ZONE 1: Attention / Needs Review (Focal) -->
        <androidx.constraintlayout.widget.Group
            android:id="@+id/contentZone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="attentionEmptyState,projectsSectionHeader,projectsContainer,projectsEmptyState,deadlinesSectionHeader,deadlinesContainer,deadlinesEmptyState" />

        <com.cutm.TeamPulse.ui.common.EmptyStateView
            android:id="@+id/attentionEmptyState"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_base"
            android:background="@drawable/bg_empty_state"
            android:padding="@dimen/spacing_xl"
            app:emptyIcon="@drawable/ic_progress"
            app:emptyMessage="@string/attention_all_on_track_message"
            app:emptyTitle="@string/attention_all_on_track"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/greetingText" />

        <!-- ZONE 2: Project Overview (Secondary) -->
        <com.cutm.TeamPulse.ui.common.SectionHeaderView
            android:id="@+id/projectsSectionHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_spacing"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/attentionEmptyState"
            app:sectionTitle="Projects" />

        <!-- Project List Container -->
        <LinearLayout
            android:id="@+id/projectsContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/projectsSectionHeader"
            tools:visibility="visible">

            <!-- Project cards will be added programmatically -->

        </LinearLayout>

        <!-- Projects Empty State -->
        <com.cutm.TeamPulse.ui.common.EmptyStateView
            android:id="@+id/projectsEmptyState"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:background="@drawable/bg_empty_state"
            android:padding="@dimen/spacing_xl"
            app:emptyIcon="@drawable/ic_empty_tasks"
            app:emptyMessage="@string/no_projects_message"
            app:emptyTitle="@string/empty_state_no_projects_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/projectsSectionHeader" />

        <!-- Barrier: Ensures deadlines section positions after whichever projects view is visible -->
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/projectsSectionBarrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="projectsContainer,projectsEmptyState" />

        <!-- ZONE 3: Upcoming Deadlines (Tertiary) -->
        <com.cutm.TeamPulse.ui.common.SectionHeaderView
            android:id="@+id/deadlinesSectionHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_spacing_compact"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/projectsSectionBarrier"
            app:sectionTitle="@string/upcoming_deadlines_section" />

        <!-- Deadlines List Container -->
        <LinearLayout
            android:id="@+id/deadlinesContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/deadlinesSectionHeader"
            tools:visibility="visible">

            <!-- Deadline items will be added programmatically -->

        </LinearLayout>

        <!-- Deadlines Empty State -->
        <com.cutm.TeamPulse.ui.common.EmptyStateView
            android:id="@+id/deadlinesEmptyState"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:background="@drawable/bg_empty_state"
            android:padding="@dimen/spacing_lg"
            app:emptyIcon="@drawable/ic_progress"
            app:emptyMessage=""
            app:emptyTitle="@string/no_deadlines"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/deadlinesSectionHeader" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>

<com.google.android.material.floatingactionbutton.FloatingActionButton
    android:id="@+id/createProjectFab"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom|end"
    android:layout_margin="@dimen/spacing_lg"
    android:contentDescription="@string/action_create_project"
    app:srcCompat="@android:drawable/ic_input_add" />

</FrameLayout>
