<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/screen_padding_horizontal"
        android:paddingEnd="@dimen/screen_padding_horizontal"
        android:paddingTop="@dimen/spacing_xl"
        android:paddingBottom="@dimen/spacing_xl"
        tools:context=".ui.student.StudentHomeFragment">

        <!-- Header Section -->
        <TextView
            android:id="@+id/greetingText"
            style="@style/TextAppearance.TeamPulse.HeadlineMedium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/student_home_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Welcome, Student" />

        <!-- XP and Badges Summary Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/progressCard"
            style="@style/Widget.TeamPulse.Card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_base"
            app:cardBackgroundColor="@color/primary_light"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/greetingText">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_lg">

                <!-- XP Section -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="@dimen/icon_size_xl"
                        android:layout_height="@dimen/icon_size_xl"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_trophy"
                        app:tint="@color/on_primary" />

                    <TextView
                        style="@style/TextAppearance.TeamPulse.NumericLarge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:text="0"
                        android:textColor="@color/on_primary"
                        tools:text="245" />

                    <TextView
                        style="@style/TextAppearance.TeamPulse.DataLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xxs"
                        android:text="EXPERIENCE"
                        android:textColor="@color/on_primary" />

                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/spacing_base"
                    android:layout_marginEnd="@dimen/spacing_base"
                    android:alpha="0.3"
                    android:background="@color/on_primary" />

                <!-- Badges Section -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="@dimen/icon_size_xl"
                        android:layout_height="@dimen/icon_size_xl"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_badge"
                        app:tint="@color/on_primary" />

                    <TextView
                        style="@style/TextAppearance.TeamPulse.NumericLarge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:text="0"
                        android:textColor="@color/on_primary"
                        tools:text="3" />

                    <TextView
                        style="@style/TextAppearance.TeamPulse.DataLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xxs"
                        android:text="BADGES"
                        android:textColor="@color/on_primary" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- My Team Section -->
        <com.cutm.TeamPulse.ui.common.SectionHeaderView
            android:id="@+id/teamSectionHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_spacing"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/progressCard"
            app:sectionTitle="My Team" />

        <!-- Team Card (or empty state) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/teamCard"
            style="@style/Widget.TeamPulse.Card.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/teamSectionHeader"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_base">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/icon_size_md"
                        android:layout_height="@dimen/icon_size_md"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_team"
                        app:tint="@color/secondary" />

                    <TextView
                        android:id="@+id/teamNameText"
                        style="@style/TextAppearance.TeamPulse.TitleMedium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        tools:text="Team Alpha" />

                </LinearLayout>

                <TextView
                    android:id="@+id/teamMembersText"
                    style="@style/TextAppearance.TeamPulse.BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:textColor="@color/text_secondary"
                    tools:text="4 members • Active" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Team Empty State -->
        <com.cutm.TeamPulse.ui.common.EmptyStateView
            android:id="@+id/teamEmptyState"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:background="@drawable/bg_empty_state"
            android:padding="@dimen/spacing_xl"
            app:emptyIcon="@drawable/ic_empty_team"
            app:emptyMessage="@string/empty_state_no_teams_message"
            app:emptyTitle="@string/empty_state_no_teams_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/teamSectionHeader" />

        <!-- My Tasks Section -->
        <com.cutm.TeamPulse.ui.common.SectionHeaderView
            android:id="@+id/tasksSectionHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_spacing"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/teamEmptyState"
            app:sectionTitle="My Tasks" />

        <!-- Tasks Container (for future RecyclerView) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/tasksContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tasksSectionHeader"
            tools:visibility="visible">

            <!-- Placeholder task cards would go here in a RecyclerView -->
            <TextView
                style="@style/TextAppearance.TeamPulse.BodyMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tasks will appear here"
                android:textColor="@color/text_tertiary"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Tasks Empty State -->
        <com.cutm.TeamPulse.ui.common.EmptyStateView
            android:id="@+id/tasksEmptyState"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:background="@drawable/bg_empty_state"
            android:padding="@dimen/spacing_xl"
            app:emptyIcon="@drawable/ic_empty_tasks"
            app:emptyMessage="@string/empty_state_no_tasks_message"
            app:emptyTitle="@string/empty_state_no_tasks_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tasksSectionHeader" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
