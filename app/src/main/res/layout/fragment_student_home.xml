<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- App Bar with Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/student_home_toolbar_title" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Existing ScrollView content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@color/background"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/screen_padding_horizontal"
        android:paddingEnd="@dimen/screen_padding_horizontal"
        android:paddingTop="@dimen/spacing_xl"
        android:paddingBottom="@dimen/spacing_xl"
        tools:context=".ui.student.StudentHomeFragment">

        <!-- Header -->
        <TextView
            android:id="@+id/greetingText"
            style="@style/TextAppearance.TeamPulse.HeadlineMedium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/student_home_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Welcome, Alex" />

        <!-- ZONE 1: Project Carousel (ViewPager2 + Indicator) -->

        <!-- ViewPager2 for project carousel -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/projectCarousel"
            android:layout_width="0dp"
            android:layout_height="200dp"
            android:layout_marginTop="@dimen/spacing_base"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/greetingText"
            tools:visibility="visible" />

        <!-- Page indicator dots -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/projectIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:background="@android:color/transparent"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/projectCarousel"
            app:tabBackground="@drawable/indicator_dot_selector"
            app:tabGravity="center"
            app:tabIconTint="@color/neutral_400"
            app:tabIndicatorHeight="0dp"
            app:tabMode="fixed"
            app:tabPadding="@dimen/spacing_xs"
            app:tabRippleColor="@color/transparent"
            tools:visibility="visible" />

        <!-- Project Empty State -->
        <com.cutm.TeamPulse.ui.common.EmptyStateView
            android:id="@+id/projectEmptyState"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_base"
            android:background="@drawable/bg_empty_state"
            android:padding="@dimen/spacing_xl"
            app:emptyIcon="@drawable/ic_project"
            app:emptyMessage="@string/no_active_project_message"
            app:emptyTitle="@string/no_active_project"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/greetingText" />

        <!-- Barrier: Ensures tasks section positions after whichever project view is visible -->
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/projectSectionBarrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="projectIndicator,projectEmptyState" />

        <!-- ZONE 2: Your Tasks Section (Secondary) -->

        <com.cutm.TeamPulse.ui.common.SectionHeaderView
            android:id="@+id/tasksSectionHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/projectSectionBarrier"
            app:sectionTitle="@string/your_tasks_section" />

        <!-- Tasks List Container -->
        <LinearLayout
            android:id="@+id/tasksContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tasksSectionHeader"
            tools:visibility="visible">

            <!-- Task items will be added programmatically -->

        </LinearLayout>

        <!-- Tasks Empty State -->
        <com.cutm.TeamPulse.ui.common.EmptyStateView
            android:id="@+id/tasksEmptyState"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:background="@drawable/bg_empty_state"
            android:padding="@dimen/spacing_lg"
            app:emptyIcon="@drawable/ic_empty_tasks"
            app:emptyMessage=""
            app:emptyTitle="No Tasks Assigned"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tasksSectionHeader" />

        <!-- Barrier: Ensures progress section positions after whichever tasks view is visible -->
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/tasksSectionBarrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="tasksContainer,tasksEmptyState" />

        <!-- ZONE 3: Gamification (Demoted) -->

        <com.cutm.TeamPulse.ui.common.SectionHeaderView
            android:id="@+id/progressSectionHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_spacing_compact"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tasksSectionBarrier"
            app:sectionTitle="Your Progress" />

        <!-- XP/Badges Placeholder (honest empty state) -->
        <com.cutm.TeamPulse.ui.common.EmptyStateView
            android:id="@+id/xpEmptyState"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:background="@drawable/bg_empty_state"
            android:padding="@dimen/spacing_lg"
            app:emptyIcon="@drawable/ic_trophy"
            app:emptyMessage="Complete tasks to earn experience points and unlock achievements."
            app:emptyTitle="Progress Tracking Coming Soon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/progressSectionHeader" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
