<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/screen_padding_horizontal"
        android:paddingEnd="@dimen/screen_padding_horizontal"
        android:paddingTop="@dimen/spacing_xl"
        android:paddingBottom="@dimen/spacing_xl"
        tools:context=".ui.student.StudentHomeFragment">

        <!-- Header -->
        <TextView
            android:id="@+id/greetingText"
            style="@style/TextAppearance.TeamPulse.HeadlineMedium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/student_home_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Welcome, Alex" />

        <!-- ZONE 1: Current Project (Focal) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/projectFocalCard"
            style="@style/Widget.TeamPulse.Card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_base"
            android:visibility="gone"
            app:cardBackgroundColor="@color/primary_light"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/greetingText"
            tools:visibility="visible">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/spacing_lg">

                <TextView
                    android:id="@+id/projectNameText"
                    style="@style/TextAppearance.TeamPulse.TitleLarge"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/on_primary"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="Mobile App Development" />

                <TextView
                    android:id="@+id/teamNameText"
                    style="@style/TextAppearance.TeamPulse.BodyMedium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xxs"
                    android:textColor="@color/on_primary"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/projectNameText"
                    tools:text="Team Alpha" />

                <TextView
                    android:id="@+id/projectProgressText"
                    style="@style/TextAppearance.TeamPulse.NumericLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:textColor="@color/on_primary"
                    android:textSize="32sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/teamNameText"
                    tools:text="65%" />

                <TextView
                    android:id="@+id/projectProgressLabel"
                    style="@style/TextAppearance.TeamPulse.LabelMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:text="Complete"
                    android:textColor="@color/on_primary"
                    app:layout_constraintBottom_toBottomOf="@id/projectProgressText"
                    app:layout_constraintStart_toEndOf="@id/projectProgressText"
                    app:layout_constraintTop_toTopOf="@id/projectProgressText" />

                <TextView
                    android:id="@+id/projectDeadlineText"
                    style="@style/TextAppearance.TeamPulse.BodyMedium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:textColor="@color/on_primary"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/projectProgressText"
                    tools:text="Due in 12 days" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Project Empty State -->
        <com.cutm.TeamPulse.ui.common.EmptyStateView
            android:id="@+id/projectEmptyState"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_base"
            android:background="@drawable/bg_empty_state"
            android:padding="@dimen/spacing_xl"
            app:emptyIcon="@drawable/ic_project"
            app:emptyMessage="@string/no_active_project_message"
            app:emptyTitle="@string/no_active_project"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/greetingText" />

        <!-- ZONE 2: Your Tasks Section (Secondary) -->
        <com.cutm.TeamPulse.ui.common.SectionHeaderView
            android:id="@+id/tasksSectionHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_spacing"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/projectEmptyState"
            app:sectionTitle="@string/your_tasks_section" />

        <!-- Tasks List Container -->
        <LinearLayout
            android:id="@+id/tasksContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tasksSectionHeader"
            tools:visibility="visible">

            <!-- Task items will be added programmatically -->

        </LinearLayout>

        <!-- Tasks Empty State -->
        <com.cutm.TeamPulse.ui.common.EmptyStateView
            android:id="@+id/tasksEmptyState"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:background="@drawable/bg_empty_state"
            android:padding="@dimen/spacing_lg"
            app:emptyIcon="@drawable/ic_empty_tasks"
            app:emptyMessage=""
            app:emptyTitle="No Tasks Assigned"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tasksSectionHeader" />

        <!-- ZONE 3: Gamification (Demoted) -->
        <com.cutm.TeamPulse.ui.common.SectionHeaderView
            android:id="@+id/progressSectionHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_spacing_compact"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tasksEmptyState"
            app:sectionTitle="Your Progress" />

        <!-- XP/Badges Placeholder (honest empty state) -->
        <com.cutm.TeamPulse.ui.common.EmptyStateView
            android:id="@+id/xpEmptyState"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:background="@drawable/bg_empty_state"
            android:padding="@dimen/spacing_lg"
            app:emptyIcon="@drawable/ic_trophy"
            app:emptyMessage="Complete tasks to earn experience points and unlock achievements."
            app:emptyTitle="Progress Tracking Coming Soon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/progressSectionHeader" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
