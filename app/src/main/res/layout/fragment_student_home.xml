<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true"
    android:clipToPadding="false">

    <!-- Premium header background with subtle gradient -->
    <View
        android:id="@+id/headerBackground"
        android:layout_width="0dp"
        android:layout_height="140dp"
        android:background="@drawable/bg_header_atmosphere"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Time-based greeting -->
    <TextView
        android:id="@+id/greetingLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="36dp"
        android:textColor="@color/text_muted"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.03"
        app:layout_constraintEnd_toStartOf="@id/accountMenuButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Good evening," />

    <!-- Premium account button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/accountMenuButton"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="28dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        app:backgroundTint="@color/surface_elevated"
        app:icon="@drawable/ic_account_circle_24"
        app:iconTint="@color/text_primary"
        app:iconSize="22dp"
        app:iconPadding="0dp"
        app:iconGravity="textStart"
        app:cornerRadius="22dp"
        app:strokeColor="@color/border_accent"
        app:strokeWidth="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- User name - prominent but controlled -->
    <TextView
        android:id="@+id/greetingText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="24dp"
        android:textColor="@color/text_primary"
        android:textSize="28sp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="-0.01"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintEnd_toStartOf="@id/accountMenuButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/greetingLabel"
        tools:text="Akash" />

    <!-- Optional contextual line -->
    <TextView
        android:id="@+id/contextLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="2dp"
        android:text="Student Dashboard"
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        android:fontFamily="sans-serif"
        android:letterSpacing="0.02"
        app:layout_constraintEnd_toStartOf="@id/accountMenuButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/greetingText"
        tools:visibility="visible" />

    <!-- Vertical scrolling content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerBackground">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="80dp">

            <!-- ============================================== -->
            <!-- ACTIVE PROJECTS SECTION -->
            <!-- ============================================== -->

            <!-- Section label -->
            <TextView
                android:id="@+id/projectSectionLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="36dp"
                android:layout_marginEnd="24dp"
                android:text="ACTIVE PROJECTS"
                android:textColor="@color/text_muted"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium"
                android:textAllCaps="true"
                android:letterSpacing="0.12"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Horizontal project carousel -->
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/projectCarousel"
                android:layout_width="0dp"
                android:layout_height="240dp"
                android:layout_marginStart="24dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="24dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:overScrollMode="never"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/projectSectionLabel"
                tools:visibility="visible" />

            <!-- Carousel indicators -->
            <LinearLayout
                android:id="@+id/projectIndicator"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/projectCarousel"
                tools:visibility="visible" />

            <!-- Premium project empty state -->
            <com.cutm.TeamPulse.ui.common.EmptyStateView
                android:id="@+id/projectEmptyState"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="24dp"
                android:visibility="gone"
                app:emptyIcon="@drawable/ic_aurora_workspace"
                app:emptyTitle="@string/no_active_project"
                app:emptyMessage="@string/no_active_project_message"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/projectSectionLabel" />

            <!-- Barrier for project section -->
            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/projectSectionBarrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="projectCarousel,projectEmptyState" />

            <!-- ============================================== -->
            <!-- MY ASSIGNED TASKS SECTION -->
            <!-- ============================================== -->

            <!-- Section header with real task count -->
            <LinearLayout
                android:id="@+id/tasksSectionHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="32dp"
                android:layout_marginEnd="24dp"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/projectSectionBarrier">

                <!-- Main section title with count badge -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="My Assigned Tasks"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="-0.01" />

                    <TextView
                        android:id="@+id/taskCountBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:text="0"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        android:background="@drawable/bg_task_count"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        tools:visibility="visible"
                        tools:text="5" />

                </LinearLayout>

                <!-- Supporting text -->
                <TextView
                    android:id="@+id/tasksSupportingText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Update task statuses as you complete project milestones."
                    android:textColor="@color/text_muted"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif"
                    android:letterSpacing="0.02" />

            </LinearLayout>

            <!-- Filter tabs container -->
            <include
                android:id="@+id/taskFilterContainer"
                layout="@layout/view_task_filters"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tasksSectionHeader" />

            <!-- Tasks container with RecyclerView for better performance -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/tasksRecyclerView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="24dp"
                android:orientation="vertical"
                android:visibility="gone"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/taskFilterContainer"
                tools:listitem="@layout/view_task_item_premium"
                tools:visibility="visible"
                tools:itemCount="3" />

            <!-- Premium empty states for each filter -->
            <com.cutm.TeamPulse.ui.common.EmptyStateView
                android:id="@+id/tasksEmptyStateAll"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="24dp"
                android:visibility="gone"
                app:emptyIcon="@drawable/ic_aurora_tasks"
                app:emptyTitle="No assigned tasks yet"
                app:emptyMessage=""
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/taskFilterContainer" />

            <com.cutm.TeamPulse.ui.common.EmptyStateView
                android:id="@+id/tasksEmptyStateTodo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="24dp"
                android:visibility="gone"
                app:emptyIcon="@drawable/ic_filter_todo"
                app:emptyTitle="No tasks to do"
                app:emptyMessage=""
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/taskFilterContainer" />

            <com.cutm.TeamPulse.ui.common.EmptyStateView
                android:id="@+id/tasksEmptyStateInProgress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="24dp"
                android:visibility="gone"
                app:emptyIcon="@drawable/ic_filter_in_progress"
                app:emptyTitle="No tasks in progress"
                app:emptyMessage=""
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/taskFilterContainer" />

            <com.cutm.TeamPulse.ui.common.EmptyStateView
                android:id="@+id/tasksEmptyStateDone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="24dp"
                android:visibility="gone"
                app:emptyIcon="@drawable/ic_filter_done"
                app:emptyTitle="No completed tasks yet"
                app:emptyMessage=""
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/taskFilterContainer" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
