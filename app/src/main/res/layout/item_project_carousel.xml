<?xml version="1.0" encoding="utf-8"?>
<!--
    Project hero card — premium dark productivity hero component.
    All ViewHolder IDs are preserved exactly:
      projectName, teamName, progressPercentage, progressBar, taskCount, deadlineChip
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingBottom="4dp">

    <!-- Premium hero card with indigo → blue gradient -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/heroCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_project_hero"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:strokeColor="@color/border_accent"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="24dp">

            <!-- Project status label -->
            <TextView
                android:id="@+id/projectStatusLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACTIVE PROJECT"
                android:textColor="@color/secondary"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium"
                android:textAllCaps="true"
                android:letterSpacing="0.12"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="ACTIVE PROJECT" />

            <!-- Project name — large, prominent -->
            <TextView
                android:id="@+id/projectName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.02"
                android:maxLines="2"
                android:ellipsize="end"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/projectStatusLabel"
                tools:text="Mobile App Development" />

            <!-- Team name with icon -->
            <TextView
                android:id="@+id/teamName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:drawableStart="@drawable/ic_team"
                android:drawablePadding="6dp"
                android:drawableTint="@color/text_muted"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:ellipsize="end"
                app:layout_constraintEnd_toStartOf="@id/deadlineChip"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/projectName"
                tools:text="Team Alpha" />

            <!-- Deadline chip — premium cyan edge -->
            <com.google.android.material.chip.Chip
                android:id="@+id/deadlineChip"
                style="@style/Widget.TeamPulse.Chip.Status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                app:chipCornerRadius="14dp"
                app:chipMinHeight="28dp"
                app:chipStartPadding="10dp"
                app:chipEndPadding="10dp"
                app:chipBackgroundColor="@color/surface_accent"
                app:chipStrokeColor="@color/secondary"
                app:chipStrokeWidth="1dp"
                app:layout_constraintBottom_toBottomOf="@id/teamName"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/teamName"
                tools:text="Due in 5 days" />

            <!-- Hero progress section -->
            <TextView
                android:id="@+id/progressPercentage"
                style="@style/TextAppearance.TeamPulse.NumericLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:textColor="@color/text_primary"
                android:textSize="48sp"
                android:fontFamily="sans-serif"
                android:letterSpacing="-0.03"
                android:includeFontPadding="false"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/teamName"
                tools:text="67%" />

            <!-- Task count label -->
            <TextView
                android:id="@+id/taskCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="2sp"
                app:layout_constraintStart_toEndOf="@id/progressPercentage"
                app:layout_constraintTop_toBottomOf="@id/teamName"
                tools:text="13 of 20\ntasks completed" />

            <!-- Premium progress bar -->
            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="12dp"
                android:layout_marginTop="20dp"
                android:progressDrawable="@drawable/progress_bar_premium"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/progressPercentage"
                tools:progress="67" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>